#!/bin/bash

INPUT="urls.txt"
OUTPUT="hasil_ip.csv"

echo "url,ip" > "$OUTPUT"

resolve_ip() {
    local target="$1"

    # ambil hostname bila input berupa URL
    host=$(echo "$target" | sed -E 's#https?://##' | cut -d/ -f1)

    # Cloudflare DoH
    ip=$(curl -s \
        --connect-timeout 3 \
        --max-time 5 \
        "https://cloudflare-dns.com/dns-query?name=${host}&type=A" \
        -H "accept: application/dns-json" \
        | jq -r '.Answer[]?.data' 2>/dev/null \
        | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
        | head -n1)

    # fallback ke resolver lokal
    if [[ -z "$ip" ]]; then
        ip=$(dig +short A "$host" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -n1)
    fi

    echo "$ip"
}

total=$(grep -cv '^$' "$INPUT")
count=0

while IFS= read -r url; do
    [[ -z "$url" ]] && continue

    ((count++))

    ip=$(resolve_ip "$url")

    echo "$url,${ip:-N/A}" >> "$OUTPUT"

    printf "[%d/%d] %s -> %s\n" \
        "$count" "$total" "$url" "${ip:-N/A}"

done < "$INPUT"

echo
echo "Done: $OUTPUT"
